# ============================================================
# Adzuna Job Search API credentials
# Register free at: https://developer.adzuna.com
# ============================================================
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here

# ============================================================
# SMTP email settings for alerts (Phase 11)
# Use an APP PASSWORD, not your main email password.
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# ============================================================
# Local REST API access key (Phase 11)
# ============================================================
API_ACCESS_KEY=change_me_to_a_random_string